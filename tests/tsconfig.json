{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    "noImplicitOverride": false,
    "noFallthroughCasesInSwitch": false,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "allowJs": false
  },
  "include": [
    "../next-env.d.ts",
    "../cloudflare-env.d.ts",
    "../src/js-yaml.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "**/*.cts"
  ]
}
