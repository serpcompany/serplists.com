{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rg *)",
      "PowerShell(rg *)"
    ],
    "ask": [
      "Bash(*wrangler * --remote*)",
      "Bash(* --allow-production*)",
      "Bash(pnpm *:staging*)",
      "Bash(pnpm *:prod*)",
      "Bash(pnpm *:remote*)",
      "Bash(pnpm *stripe:portal:configure*)",
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler versions deploy*)",
      "Bash(*wrangler versions upload*)",
      "Bash(*wrangler rollback*)",
      "Bash(*wrangler delete*)",
      "Bash(*wrangler secret *)",
      "Bash(*opennextjs-cloudflare deploy*)",
      "Bash(*opennextjs-cloudflare upload*)",
      "Bash(stripe * --live*)",
      "PowerShell(*wrangler * --remote*)",
      "PowerShell(* --allow-production*)",
      "PowerShell(pnpm *:staging*)",
      "PowerShell(pnpm *:prod*)",
      "PowerShell(pnpm *:remote*)",
      "PowerShell(pnpm *stripe:portal:configure*)",
      "PowerShell(*wrangler deploy*)",
      "PowerShell(*wrangler versions deploy*)",
      "PowerShell(*wrangler versions upload*)",
      "PowerShell(*wrangler rollback*)",
      "PowerShell(*wrangler delete*)",
      "PowerShell(*wrangler secret *)",
      "PowerShell(*opennextjs-cloudflare deploy*)",
      "PowerShell(*opennextjs-cloudflare upload*)",
      "PowerShell(stripe * --live*)"
    ]
  }
}
