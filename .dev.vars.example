# Required auth/session secrets (32+ chars)
BETTER_AUTH_SECRET=replace-with-32-char-secret
# Legacy fallback only (optional)
JWT_SECRET=replace-with-32-char-secret

# Optional frontend/CORS config
FRONTEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Optional uploads config
R2_PUBLIC_BASE_URL=https://files.example.com

# Email delivery (required for password reset + email verification emails)
# Configure at least one provider key:
RESEND_API_KEY=re_xxx
USESEND_API_KEY=us_xxx
# Optional sender override (defaults to noreply@mail.auth.serp.co)
EMAIL_FROM=SERP Lists <support@example.com>

# Optional Stripe/billing config
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRO_PRICE_ID=price_xxx

# Optional admin/ops
ENTITLEMENTS_ADMIN_SECRET=replace-with-admin-secret

# Optional client override consumed by Vite scripts
VITE_API_URL=http://localhost:8788/api
