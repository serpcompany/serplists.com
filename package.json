{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npx wrangler pages dev ./dist --local --port 8788",
    "dev:all": "concurrently \"pnpm run dev\" \"pnpm run dev:api\"",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:env": "node scripts/check-env.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "sre:dup": "jscpd --ignore \"**/node_modules/**,**/dist/**,**/coverage/**,**/playwright-report/**,**/test-results/**,**/.wrangler/**,**/.turbo/**,**/db/migrations/**\" src functions || true",
    "sre:deps": "depcruise --no-config --exclude \"node_modules|dist|coverage|playwright-report|test-results|\\\\.wrangler|\\\\.turbo|db/migrations\" src functions || true",
    "db:seed": "npx wrangler d1 execute serp-checklists-db --local --file=./db/migrations/seed-test-data.sql",
    "db:reset": "node -e \"require('fs').rmSync('.wrangler/state/v3/d1/miniflare-D1DatabaseObject', { recursive: true, force: true });\" && npx wrangler d1 execute serp-checklists-db --local --file=./db/migrations/0001_initial_schema.sql && npx wrangler d1 execute serp-checklists-db --local --file=./db/migrations/0002_add_slug_to_templates.sql && npx wrangler d1 execute serp-checklists-db --local --file=./db/migrations/0002_add_username_and_profiles.sql && npx wrangler d1 execute serp-checklists-db --local --file=./db/migrations/0003_unique_template_slugs.sql && npx wrangler d1 execute serp-checklists-db --local --file=./db/migrations/0004_remove_affiliate_and_pages.sql && npx wrangler d1 execute serp-checklists-db --local --file=./db/migrations/0005_backfill_template_slugs.sql && npx wrangler d1 execute serp-checklists-db --local --file=./db/migrations/0007_add_checklist_run_progress.sql && npm run db:seed",
    "db:generate": "drizzle-kit generate --config db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config db/drizzle.config.ts",
    "db:cleanup:local": "npx wrangler d1 execute serp-checklists-db --local --file=./db/migrations/cleanup-seed-data.sql",
    "db:cleanup:remote": "npx wrangler d1 execute serp-checklists-db --remote --file=./db/migrations/cleanup-seed-data.sql",
    "db:backfill-slugs:local": "npx wrangler d1 execute serp-checklists-db --local --file=./db/migrations/0005_backfill_template_slugs.sql",
    "db:backfill-slugs:remote": "npx wrangler d1 execute serp-checklists-db --remote --file=./db/migrations/0005_backfill_template_slugs.sql",
    "db:migrate:progress:local": "npx wrangler d1 execute serp-checklists-db --local --file=./db/migrations/0007_add_checklist_run_progress.sql",
    "db:migrate:progress:remote": "npx wrangler d1 execute serp-checklists-db --remote --file=./db/migrations/0007_add_checklist_run_progress.sql",
    "db:seed:official:remote": "npx wrangler d1 execute serp-checklists-db --remote --file=./db/migrations/0006_seed_official_templates.sql",
    "db:query": "npx wrangler d1 execute serp-checklists-db --local --command",
    "prepare": "husky"
  },
