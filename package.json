{
  "name": "serplists",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:all": "node scripts/dev-auto.mjs",
    "dev:api": "node scripts/dev-auto.mjs",
    "dev:auto": "node scripts/dev-auto.mjs",
    "dev:stop": "node scripts/dev-stop.mjs",
    "logs:query": "tsx scripts/logs-query.ts",
    "promote:prepare": "node scripts/promote-prepare.mjs",
    "setup": "node scripts/setup-local.mjs",
    "build": "pnpm run sitemap:generate && pnpm run headers:generate && next build",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json && tsc -p functions/tsconfig.json && tsc -p tests/tsconfig.json",
    "typecheck:env": "node scripts/check-env.mjs",
    "verify": "pnpm run typecheck:env && pnpm run lint && pnpm run typecheck && pnpm run check:repo && pnpm run test:run",
    "check:repo": "pnpm run secret:scan && pnpm run docs:check && pnpm run comments:check && pnpm run deps:check && pnpm run duplicates:check && pnpm run schema:portable:check && pnpm run db:schema:check && pnpm run templates:check",
    "docs:check": "node scripts/check-docs.mjs",
    "comments:check": "node scripts/check-no-comments.mjs",
    "duplicates:check": "jscpd tests",
    "docs:references": "node scripts/update-references.mjs",
    "deps:check": "depcruise --config .dependency-cruiser.cjs src functions db",
    "maintenance:report": "node scripts/maintenance-report.mjs",
    "check:preview:d1-binding": "node scripts/check-preview-d1-binding.mjs",
    "check:prod:d1-schema": "node scripts/check-production-d1-schema.mjs --database serp-checklists-db --label production",
    "check:staging:d1-schema": "node scripts/check-production-d1-schema.mjs --database DB --label staging --preview",
    "schema:portable:generate": "tsx scripts/generate-portable-template-json-schema.ts",
    "schema:portable:check": "tsx scripts/generate-portable-template-json-schema.ts --check",
    "db:schema:generate": "tsx scripts/generate-db-schema-doc.ts",
    "db:schema:check": "tsx scripts/generate-db-schema-doc.ts --check",
    "d1:profile": "tsx scripts/d1-profile.ts",
    "sitemap:generate": "tsx scripts/generate-sitemap-catalog.ts",
    "sitemap:check": "tsx scripts/generate-sitemap-catalog.ts --check",
    "headers:generate": "tsx scripts/generate-static-headers.ts",
    "templates:check": "tsx scripts/check-template-sources.ts",
    "templates:generate": "tsx scripts/generate-template-assets.ts",
    "templates:render-markdown": "tsx scripts/render-template-markdown.ts",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "test": "vitest",
    "test:run": "vitest run --exclude tests/integration/local-d1-fixtures.test.ts --exclude tests/integration/personal-run-mcp-local-d1.test.ts --exclude tests/integration/personal-run-mcp-templates-local-d1.test.ts --exclude tests/integration/setup-local-seed.test.ts --exclude tests/integration/run-source-access-local-d1.test.ts --exclude tests/integration/plan-limits-concurrency-local-d1.test.ts --exclude tests/integration/run-sharing-local-d1.test.ts --exclude tests/integration/audit-guards-local-d1.test.ts --exclude tests/integration/api-router-local-d1.test.ts --exclude tests/integration/rows-read-budgets-local-d1.test.ts",
    "test:unit": "pnpm run test:run",
    "test:local-d1": "vitest run --testTimeout=20000 tests/integration/local-d1-fixtures.test.ts tests/integration/personal-run-mcp-local-d1.test.ts tests/integration/personal-run-mcp-templates-local-d1.test.ts tests/integration/setup-local-seed.test.ts tests/integration/run-source-access-local-d1.test.ts tests/integration/plan-limits-concurrency-local-d1.test.ts tests/integration/run-sharing-local-d1.test.ts tests/integration/audit-guards-local-d1.test.ts tests/integration/api-router-local-d1.test.ts tests/integration/rows-read-budgets-local-d1.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node tests/e2e/run-smoke.mjs",
    "test:e2e:full": "node tests/e2e/run-smoke.mjs --all --workers=1",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ui:snap": "node scripts/ui-snapshot.mjs",
    "verify:release": "pnpm run verify && pnpm run test:local-d1 && pnpm run test:smoke",
    "verify:staging": "pnpm run check:preview:d1-binding && pnpm run db:migrations:check:staging && pnpm run check:staging:d1-schema",
    "verify:prod:d1": "pnpm run db:migrations:check:prod && pnpm run check:prod:d1-schema",
    "secret:scan": "node scripts/secret-scan.mjs",
    "stripe:portal:configure": "node scripts/stripe/configure-portal.mjs",
    "stripe:local:setup": "node scripts/stripe/setup-local-test.mjs",
    "stripe:local:listen": "node scripts/stripe/listen-local.mjs",
    "stripe:local:scrub-live": "node scripts/stripe/scrub-local-live.mjs",
    "db:seed": "pnpm exec tsx scripts/data/local-d1-data.ts seed-test && npx wrangler d1 execute serp-checklists-db --local --file=./db/seeds/official-templates.sql && pnpm exec tsx scripts/data/local-d1-data.ts seed-official-login",
    "db:reset": "node scripts/d1-reset-local.mjs",
    "db:migrations:list:local": "npx wrangler d1 migrations list serp-checklists-db --local",
    "db:migrations:list:staging": "npx wrangler d1 migrations list DB --remote --preview",
    "db:migrations:list:prod": "npx wrangler d1 migrations list serp-checklists-db --remote",
    "db:migrations:check:staging": "node scripts/check-pending-d1-migrations.mjs --database DB --label staging --preview",
    "db:migrations:check:prod": "node scripts/check-pending-d1-migrations.mjs --database serp-checklists-db --label production",
    "db:migrations:baseline:staging": "node scripts/d1-baseline-migrations.mjs --remote --database DB --preview",
    "db:migrations:baseline:prod": "node scripts/d1-baseline-migrations.mjs --remote --database serp-checklists-db --allow-production",
    "db:migrate:d1:local": "npx wrangler d1 migrations apply serp-checklists-db --local",
    "db:migrate:d1:staging": "npx wrangler d1 migrations apply DB --remote --preview",
    "db:migrate:d1:prod": "npx wrangler d1 migrations apply serp-checklists-db --remote",
    "db:reset:test-user-passwords": "pnpm exec tsx scripts/data/local-d1-data.ts reset-passwords",
    "db:generate": "drizzle-kit generate --config db/drizzle.config.ts",
    "check:db:drizzle-parity": "node scripts/data/check-drizzle-schema-parity.mjs",
    "db:cleanup:local": "pnpm exec tsx scripts/data/local-d1-data.ts cleanup",
    "db:seed:official:local": "npx wrangler d1 execute serp-checklists-db --local --file=./db/seeds/official-templates.sql && pnpm exec tsx scripts/data/local-d1-data.ts seed-official-login",
    "db:seed:official:staging": "npx wrangler d1 execute DB --remote --preview --file=./db/seeds/official-templates.sql",
    "db:seed:official:remote": "npx wrangler d1 execute serp-checklists-db --remote --file=./db/seeds/official-templates.sql",
    "db:query": "npx wrangler d1 execute serp-checklists-db --local --command",
    "prepare": "lefthook install || echo git hooks not installed"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^3.9.0",
    "@opennextjs/cloudflare": "^1.20.7",
    "@t3-oss/env-core": "^0.13.10",
    "@tanstack/react-query": "^5.56.2",
    "@uiw/react-md-editor": "^4.0.8",
    "bcryptjs": "^3.0.2",
    "better-auth": "1.3.4",
    "caniuse-lite": "^1.0.30001800",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.0.0",
    "cn": "^0.4.0",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.45.1",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.462.0",
    "next": "16.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.53.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^1.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250810.0",
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.57.0",
    "@secretlint/node": "^11.3.1",
    "@secretlint/secretlint-rule-preset-recommend": "^11.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.15",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "ajv": "8.18.0",
    "dependency-cruiser": "^17.3.6",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.9.0",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jscpd": "^4.0.7",
    "lefthook": "^2.0.15",
    "lint-staged": "^16.1.5",
    "postcss": "^8.5.23",
    "secretlint": "^11.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.143.0",
    "xmllint-wasm": "5.3.0",
    "yaml": "2.8.1",
    "zod-to-json-schema": "^3.25.1"
  },
  "packageManager": "pnpm@9.2.0+sha1.886364ebd6dae009284bebc56ed4296bb6dd557a",
  "pnpm": {
    "patchedDependencies": {
      "wrangler@4.143.0": "patches/wrangler@4.143.0.patch"
    }
  }
}
