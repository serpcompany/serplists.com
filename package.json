{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.1 <23",
    "pnpm": "9.2.0"
  },
  "scripts": {
    "dev": "node scripts/dev-auto.mjs frontend",
    "dev:api": "node scripts/dev-auto.mjs api",
    "dev:all": "node scripts/dev-auto.mjs all",
    "dev:auto": "node scripts/dev-auto.mjs all",
    "build": "pnpm run sitemap:generate && dotenv -e .dev.vars -- vite build",
    "build:dev": "pnpm run sitemap:generate && dotenv -e .dev.vars -- vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.app.json --noEmit && tsc --project tsconfig.worker.json --noEmit && tsc --project tsconfig.node.json --noEmit",
    "typecheck:env": "node scripts/check-env.mjs",
    "check:preview:d1-binding": "node scripts/check-preview-d1-binding.mjs",
    "check:data:schema-contract": "tsx scripts/data/check-schema-contract.ts",
    "check:prod:d1-schema": "tsx scripts/data/check-d1-schema.ts --database serp-checklists-db --label production",
    "check:staging:d1-schema": "tsx scripts/data/check-d1-schema.ts --database serp-checklists-staging-db --label staging",
    "auth:reset:official:serp": "node scripts/data/production-path-blocked.mjs",
    "billing:set:official:serp": "node scripts/data/production-path-blocked.mjs",
    "schema:portable:generate": "tsx scripts/generate-portable-template-json-schema.ts",
    "schema:portable:check": "tsx scripts/generate-portable-template-json-schema.ts --check",
    "sitemap:generate": "tsx scripts/generate-sitemap-catalog.ts",
    "sitemap:check": "tsx scripts/generate-sitemap-catalog.ts --check",
    "templates:check": "tsx scripts/check-template-sources.ts",
    "templates:generate": "tsx scripts/generate-template-assets.ts",
    "templates:render-markdown": "tsx scripts/render-template-markdown.ts",
    "preview": "dotenv -e .dev.vars -- vite preview",
    "test": "vitest",
    "test:run": "vitest run --config vitest.unit.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:database:fast": "vitest run --config vitest.fast-database.config.ts",
    "test:process": "vitest run --config vitest.process.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:hooks": "vitest run scripts/hooks/hook-enforcement.test.mjs",
    "test:smoke": "tsx scripts/run-playwright-smoke.mjs",
    "test:data:routes": "tsx scripts/run-playwright-smoke.mjs",
    "test:data-regressions": "pnpm run verify:quality && pnpm run verify:database && pnpm run test:process && pnpm run test:data:integration",
    "test:e2e": "tsx scripts/run-playwright-smoke.mjs",
    "test:e2e:ui": "node scripts/run-playwright-smoke.mjs --diagnostic-selection --ui",
    "verify:release": "pnpm run test:data-regressions && pnpm run build",
    "verify:staging": "pnpm run check:preview:d1-binding && pnpm run check:data:schema-contract && pnpm run db:migrations:check:staging && pnpm run check:staging:d1-schema",
    "verify:prod:d1": "pnpm run check:data:schema-contract && pnpm run db:migrations:check:prod && pnpm run check:prod:d1-schema",
    "sre:dup": "jscpd --ignore \"**/node_modules/**,**/dist/**,**/coverage/**,**/playwright-report/**,**/test-results/**,**/.wrangler/**,**/.turbo/**,**/db/migrations/**\" src functions || true",
    "sre:deps": "depcruise --no-config --exclude \"node_modules|dist|coverage|playwright-report|test-results|\\\\.wrangler|\\\\.turbo|db/migrations\" src functions || true",
    "secret:scan": "node scripts/secret-scan.mjs",
    "db:seed": "tsx scripts/data/seed-local.ts --profile all",
    "db:reset": "tsx scripts/d1-reset-local.mjs",
    "db:migrations:list:local": "npx wrangler d1 migrations list serp-checklists-db --local",
    "db:migrations:list:staging": "node scripts/data/remote-path-blocked.mjs",
    "db:migrations:list:prod": "node scripts/data/production-path-blocked.mjs",
    "db:migrations:check:local": "node scripts/data/check-pending-migrations.mjs --database serp-checklists-db --label local --local",
    "db:migrations:check:staging": "node scripts/data/check-pending-migrations.mjs --database serp-checklists-staging-db --database-id fcaf4325-5be7-4ead-ab60-45932a04177b --label staging --remote",
    "db:migrations:check:prod": "node scripts/data/check-pending-migrations.mjs --database serp-checklists-db --database-id b62ccc0a-9c69-4828-9e9b-3bac6ba0e4f1 --label production --remote",
    "db:migrations:baseline:staging": "node scripts/data/remote-path-blocked.mjs",
    "db:migrations:baseline:prod": "node scripts/data/production-path-blocked.mjs",
    "db:migrate:d1:local": "npx wrangler d1 migrations apply serp-checklists-db --local",
    "db:migrate:d1:staging": "node scripts/data/remote-path-blocked.mjs",
    "db:migrate:d1:prod": "node scripts/data/production-path-blocked.mjs",
    "db:reset:test-user-passwords": "npx wrangler d1 execute serp-checklists-db --local --file=./db/maintenance/reset-test-user-passwords.sql",
    "db:generate": "node scripts/data/generate-drizzle-migration.mjs",
    "check:data:migration-provenance": "node scripts/data/check-migration-provenance.mjs",
    "test:data:migration-provenance": "node --test scripts/data/migration-provenance.node-test.mjs",
    "db:schema:snapshot": "tsx scripts/data/generate-schema-snapshot.ts",
    "db:schema:snapshot:check": "tsx scripts/data/generate-schema-snapshot.ts --check",
    "db:migrate": "node scripts/data/production-path-blocked.mjs",
    "db:cleanup:local": "tsx scripts/data/seed-local.ts --profile cleanup-test-data",
    "db:cleanup:remote": "node scripts/data/production-path-blocked.mjs",
    "db:seed:official:local": "tsx scripts/data/seed-local.ts --profile official-templates && tsx scripts/data/seed-local.ts --profile official-login",
    "db:seed:official:staging": "node scripts/data/remote-path-blocked.mjs",
    "db:seed:official:remote": "node scripts/data/production-path-blocked.mjs",
    "db:query": "npx wrangler d1 execute serp-checklists-db --local --command",
    "prepare": "node scripts/install-lefthook.mjs",
    "test:data:assertions": "vitest run --config vitest.data.config.ts",
    "test:data:integration": "tsx scripts/data/run-data-regression-suite.ts",
    "verify:quality": "pnpm run lint && pnpm run typecheck && pnpm run typecheck:env && pnpm run test:unit",
    "verify:fast": "pnpm run test:unit && pnpm run test:database:fast",
    "verify:database": "pnpm run check:data:migration-provenance && pnpm run test:data:migration-provenance && pnpm run check:data:schema-contract && pnpm run db:schema:snapshot:check && pnpm run test:database:fast"
  },
