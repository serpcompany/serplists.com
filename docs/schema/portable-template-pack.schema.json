{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "serplists-template-pack"
    },
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "exportedAt": {
      "type": "string"
    },
    "exportedBy": {
      "type": "string"
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "checklist",
              "recipe"
            ]
          },
          "slug": {
            "type": "string"
          },
          "seoTitle": {
            "type": "string"
          },
          "seoDescription": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "private"
            ]
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "description": {
                        "type": "string"
                      },
                      "contents": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "type": {
                              "type": "string",
                              "enum": [
                                "text",
                                "image",
                                "video",
                                "file",
                                "embed",
                                "subItems"
                              ]
                            },
                            "value": {
                              "type": "string",
                              "default": ""
                            },
                            "uploadType": {
                              "type": "string",
                              "enum": [
                                "url",
                                "upload"
                              ]
                            },
                            "fileName": {
                              "type": "string"
                            },
                            "fileSize": {
                              "type": "number"
                            },
                            "subItems": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "string"
                                  },
                                  "title": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "required": [
                                  "title"
                                ],
                                "additionalProperties": false
                              }
                            }
                          },
                          "required": [
                            "type"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "title"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "title",
                "items"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "value": {},
                "severity": {
                  "type": "string",
                  "enum": [
                    "error",
                    "warning"
                  ],
                  "default": "error"
                }
              },
              "required": [
                "id",
                "type",
                "path"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "sections"
        ],
        "additionalProperties": false
      }
    },
    "manifest": {
      "type": "object",
      "properties": {
        "totalTemplates": {
          "type": "integer",
          "minimum": 0
        },
        "format": {
          "type": "string",
          "const": "portable"
        },
        "includesVisibility": {
          "type": "boolean"
        },
        "includesRules": {
          "type": "boolean"
        },
        "assetWarnings": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "totalTemplates"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "exportedAt",
    "templates"
  ],
  "additionalProperties": false,
  "title": "Serplists Portable Template Pack v2.0.0",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://serplists.com/schema/portable-template-pack.schema.json",
  "description": "Canonical portable Serplists template-pack contract generated from the Zod source of truth."
}
